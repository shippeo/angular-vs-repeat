  },
  "main": "dist/angular-vs-repeat.min.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamilkp/angular-vs-repeat.git"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "chai": "4.1.2",
    "eslint": "git+https://github.com/kamilkp/eslint.git#bc9ae3fb6f4ea8a001b8b656fcd2a27b742583ef",
    "karma": "^2.0.0",
    "karma-chai": "^0.1.0",
    "karma-chrome-launcher": "~0.1.4",
    "karma-firefox-launcher": "~0.1.3",
    "karma-mocha": "~0.1.3",
    "mocha": "4.0.1",
    "terser": "^5.44.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:js": "babel src/angular-vs-repeat.js -o dist/angular-vs-repeat.js",
    "build:min": "terser dist/angular-vs-repeat.js -c -m -o dist/angular-vs-repeat.min.js",
    "build": "npm run clean && npm run build:js && npm run build:min",
    "check": "node scripts/check-contract.mjs",
    "test": "karma start --single-run"
