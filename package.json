{
  "name": "angular-vs-repeat",
  "version": "2.0.13",
  "description": "Virtual Scroll for AngularJS ngRepeat directive",
  "homepage": "http://kamilkp.github.io/angular-vs-repeat",
  "license": "MIT",
  "author": {
    "name": "Kamil Pekala",
    "email": "kamilkp@gmail.com",
